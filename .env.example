# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Use URL-safe passwords (letters, digits, - and _) because they are embedded in connection URLs.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

APP_ENV=local

# Database bootstrap (docker compose)
POSTGRES_DB=supportpilot
POSTGRES_USER=supportpilot_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
APP_DB_PASSWORD=CHANGE_ME_app_password

# API
# Signs session cookies. At least 32 characters. Production refuses placeholder values.
SESSION_SECRET=CHANGE_ME_at_least_32_characters_long_random
# false only for local http development; must be true in staging and production
COOKIE_SECURE=false
# JSON list of exact origins allowed to call the API with credentials
CORS_ORIGINS=["http://localhost:3000"]
